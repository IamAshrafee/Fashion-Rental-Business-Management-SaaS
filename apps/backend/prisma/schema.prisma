  tenantId           String   @map("tenant_id")
  productId          String   @map("product_id")
  variantId          String?  @map("variant_id")
  policyVersionId    String   @map("policy_version_id")
  startAt            DateTime @map("start_at") @db.Timestamptz
  endAt              DateTime @map("end_at") @db.Timestamptz
  customerContext    Json?    @map("customer_context") @db.JsonB
  selectedAddons     Json?    @map("selected_addons") @db.JsonB
  inputsHash         String   @map("inputs_hash")
  currency           String   @default("BDT") @db.Char(3)
  billableDays       Int      @map("billable_days")
  subtotalMinor      Int      @map("subtotal_minor")
  depositMinor       Int      @map("deposit_minor")
  totalDueNowMinor   Int      @map("total_due_now_minor")
  totalDueLaterMinor Int      @map("total_due_later_minor")
  expiresAt          DateTime @map("expires_at") @db.Timestamptz
  createdAt          DateTime @default(now()) @map("created_at")

  policyVersion PricePolicyVersion @relation(fields: [policyVersionId], references: [id])
  lineItems     QuoteLineItem[]

  @@index([tenantId, inputsHash])
  @@map("quotes")
}

model QuoteLineItem {
  id          String              @id @default(uuid())
  quoteId     String              @map("quote_id")
  type        String // e.g. 'BASE_RENTAL', 'CLEANING_FEE', 'DEPOSIT', 'DISCOUNT'
  label       String
  amountMinor Int                 @map("amount_minor")
  refundable  Boolean             @default(false)
  visibility  ComponentVisibility @default(CUSTOMER)
  metadata    Json?               @db.JsonB

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_line_items")
}

/// Short-lived authoritative quote for a complete owner-created rental.
model BookingQuote {
  id               String                @id @default(uuid())
  tenantId         String                @map("tenant_id")
  inputsHash       String                @map("inputs_hash")
  quoteHash        String                @map("quote_hash")
  currency         String                @default("BDT") @db.Char(3)
  sourceLocationId String                @map("source_location_id")
  rentalStartDate  DateTime              @map("rental_start_date") @db.Date
  rentalEndDate    DateTime              @map("rental_end_date") @db.Date
  handoverMethod   BookingHandoverMethod @map("handover_method")
  returnMethod     BookingReturnMethod   @map("return_method")
  requestSnapshot  Json                  @map("request_snapshot") @db.JsonB
  itemizedLines    Json                  @map("itemized_lines") @db.JsonB
  availabilityPlan Json                  @map("availability_plan") @db.JsonB
  policyVersionIds Json                  @map("policy_version_ids") @db.JsonB
  subtotal         Int
  totalFees        Int                   @default(0) @map("total_fees")
  shippingFee      Int                   @default(0) @map("shipping_fee")
  totalDeposit     Int                   @default(0) @map("total_deposit")
  discountAmount   Int                   @default(0) @map("discount_amount")
  grandTotal       Int                   @map("grand_total")
  expiresAt        DateTime              @map("expires_at") @db.Timestamptz
  createdByUserId  String?               @map("created_by_user_id")
  createdAt        DateTime              @default(now()) @map("created_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceLocation InventoryLocation @relation(fields: [sourceLocationId], references: [id], onDelete: Restrict)
  booking        Booking?

  @@index([tenantId, expiresAt])
  @@index([tenantId, inputsHash])
  @@map("booking_quotes")
}

model StorefrontCheckoutQuote {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  cartId           String   @map("cart_id")
  requestHash      String   @map("request_hash")
  quoteHash        String   @map("quote_hash")
  requestSnapshot  Json     @map("request_snapshot") @db.JsonB
  responseSnapshot Json     @map("response_snapshot") @db.JsonB
  grandTotal       Int      @map("grand_total")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart    StorefrontCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  booking Booking?

  @@index([tenantId, expiresAt])
  @@index([cartId, expiresAt])
  @@index([tenantId, requestHash, createdAt(sort: Desc)])
  @@map("storefront_checkout_quotes")
}

model StorefrontCart {
  id             String               @id @default(uuid())
  tenantId       String               @map("tenant_id")
  tokenHash      String               @unique @map("token_hash")
  status         StorefrontCartStatus @default(ACTIVE)
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz
  lastActivityAt DateTime             @default(now()) @map("last_activity_at") @db.Timestamptz
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  tenant  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines   StorefrontCartLine[]
  quotes  StorefrontCheckoutQuote[]
  booking Booking?

  @@index([tenantId, status, expiresAt])
  @@index([tenantId, lastActivityAt(sort: Desc)])
  @@map("storefront_carts")
}

model StorefrontCartLine {
  id              String   @id @default(uuid())
  cartId          String   @map("cart_id")
  lineKey         String   @map("line_key")
  productId       String   @map("product_id")
  variantId       String   @map("variant_id")
  variantSizeId   String   @map("variant_size_id")
  quantity        Int      @default(1)
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  selectedSize    String?  @map("selected_size")
  configuration   Json     @default("{}") @db.JsonB
  displaySnapshot Json     @default("{}") @map("display_snapshot") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  cart        StorefrontCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantSize VariantSize    @relation(fields: [variantSizeId], references: [id], onDelete: Restrict)

  @@unique([cartId, lineKey])
  @@index([cartId, updatedAt(sort: Desc)])
  @@index([productId, variantSizeId])
  @@map("storefront_cart_lines")
}

// ============================================================================
// SIZING MODULE — Schema-Driven Architecture
// ============================================================================

model ProductType {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  name                String
  slug                String
  description         String?  @db.VarChar(255)
  defaultSizeSchemaId String?  @map("default_size_schema_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  defaultSizeSchema SizeSchema? @relation(fields: [defaultSizeSchemaId], references: [id])
  products          Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([defaultSizeSchemaId])
  @@map("product_types")
}

model SizeSchema {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  code        String
  name        String
  description String?          @db.VarChar(255)
  schemaType  String           @default("STANDARD") @map("schema_type")
  status      SizeSchemaStatus @default(draft)
  definition  Json             @default("{}") @db.JsonB
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  instances              SizeInstance[]
  productTypes           ProductType[]
  productSchemaOverrides Product[]      @relation("ProductSchemaOverride")
  sizeCharts             SizeChart[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("size_schemas")
}

model SizeInstance {
  id            String   @id @default(uuid())
  sizeSchemaId  String   @map("size_schema_id")
  normalizedKey String   @map("normalized_key")
  displayLabel  String   @map("display_label")
  payload       Json     @default("{}") @db.JsonB
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sizeSchema   SizeSchema    @relation(fields: [sizeSchemaId], references: [id])
  variantSizes VariantSize[]

  @@unique([sizeSchemaId, normalizedKey])
  @@index([sizeSchemaId])
  @@map("size_instances")
}

model SizeChart {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  sizeSchemaId String   @map("size_schema_id")
  productId    String?  @map("product_id")
  title        String   @default("Size Guide")
  chartMeta    Json     @default("{}") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sizeSchema SizeSchema     @relation(fields: [sizeSchemaId], references: [id])
  product    Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  rows       SizeChartRow[]

  @@index([tenantId])
  @@index([sizeSchemaId])
  @@index([productId])
  @@map("size_charts")
}

model SizeChartRow {
  id           String @id @default(uuid())
  sizeChartId  String @map("size_chart_id")
  sizeLabel    String @map("size_label")
  measurements Json   @default("{}") @db.JsonB
  sortOrder    Int    @default(0) @map("sort_order")

  sizeChart SizeChart @relation(fields: [sizeChartId], references: [id], onDelete: Cascade)

  @@index([sizeChartId, sortOrder])
  @@map("size_chart_rows")
}

// ============================================================================
// CATEGORIES & EVENTS
// ============================================================================

model Category {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  slug         String
  icon         String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  subcategories Subcategory[]
  products      Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model Subcategory {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  categoryId   String   @map("category_id")
  name         String
  slug         String
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  category Category  @relation(fields: [categoryId], references: [id])
  products Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([tenantId])
  @@map("subcategories")
}

model Event {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  slug         String
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  products ProductEvent[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("events")
}

model ProductEvent {
  id        String @id @default(uuid())
  productId String @map("product_id")
  eventId   String @map("event_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([productId, eventId])
  @@index([eventId])
  @@map("product_events")
}

model ProductFaq {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  productId String   @map("product_id")
  question  String
  answer    String
  sequence  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([tenantId])
  @@map("product_faqs")
}

// ============================================================================
// CUSTOMERS
// ============================================================================

model Customer {
  id                      String                 @id @default(uuid())
  tenantId                String                 @map("tenant_id")
  fullName                String                 @map("full_name")
  status                  CustomerStatus         @default(active)
  preferredContactChannel CustomerContactChannel @default(phone) @map("preferred_contact_channel")
  preferredLocale         String                 @default("en-BD") @map("preferred_locale")
  source                  String?
  totalBookings           Int                    @default(0) @map("total_bookings")
  totalSpent              Int                    @default(0) @map("total_spent")
  lastBookingAt           DateTime?              @map("last_booking_at")
  mergedIntoCustomerId    String?                @map("merged_into_customer_id")
  archivedAt              DateTime?              @map("archived_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  identities     CustomerIdentity[]
  addresses      CustomerAddress[]
  tagAssignments CustomerTagAssignment[]
  notes          CustomerNote[]
  consents       CustomerConsent[]
  events         CustomerEvent[]
  account        CustomerAccount?
  bookings       Booking[]
  reviews        Review[]
  mergedInto     Customer?               @relation("CustomerMerges", fields: [mergedIntoCustomerId], references: [id], onDelete: Restrict)
  mergedSources  Customer[]              @relation("CustomerMerges")

  @@index([tenantId, status, updatedAt(sort: Desc)])
  @@index([tenantId, fullName])
  @@index([mergedIntoCustomerId])
  @@map("customers")
}

model CustomerIdentity {
  id              String               @id @default(uuid())
  tenantId        String               @map("tenant_id")
  customerId      String               @map("customer_id")
  kind            CustomerIdentityKind
  value           String
  normalizedValue String               @map("normalized_value")
  isPrimary       Boolean              @default(false) @map("is_primary")
  verifiedAt      DateTime?            @map("verified_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accounts CustomerAccount[]

  @@unique([tenantId, kind, normalizedValue])
  @@index([customerId, kind])
  @@map("customer_identities")
}

model CustomerAddress {
  id            String              @id @default(uuid())
  tenantId      String              @map("tenant_id")
  customerId    String              @map("customer_id")
  kind          CustomerAddressKind @default(delivery)
  label         String?
  recipientName String?             @map("recipient_name")
  phone         String?
  addressLine1  String              @map("address_line1")
  addressLine2  String?             @map("address_line2")
  area          String?
  city          String?
  state         String?
  postalCode    String?             @map("postal_code")
  country       String              @default("BD")
  instructions  String?
  isDefault     Boolean             @default(false) @map("is_default")
  lastUsedAt    DateTime?           @map("last_used_at")
  archivedAt    DateTime?           @map("archived_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, kind, archivedAt])
  @@index([tenantId, city])
  @@map("customer_addresses")
}

model CustomerTagDefinition {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant                  @relation(fields: [tenantId], references: [id])
  assignments CustomerTagAssignment[]

  @@unique([tenantId, name])
  @@map("customer_tag_definitions")
}

model CustomerTagAssignment {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  tagId      String   @map("tag_id")
  assignedBy String?  @map("assigned_by")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  customer Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      CustomerTagDefinition @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([customerId, tagId])
  @@index([tenantId, tagId])
  @@map("customer_tag_assignments")
}

model CustomerNote {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  body       String
  isPinned   Boolean  @default(false) @map("is_pinned")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isPinned, createdAt(sort: Desc)])
  @@map("customer_notes")
}

model CustomerConsent {
  id         String                  @id @default(uuid())
  tenantId   String                  @map("tenant_id")
  customerId String                  @map("customer_id")
  purpose    String
  channel    CustomerContactChannel?
  granted    Boolean
  source     String
  recordedBy String?                 @map("recorded_by")
  recordedAt DateTime                @default(now()) @map("recorded_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose, recordedAt(sort: Desc)])
  @@map("customer_consents")
}

model CustomerEvent {
  id         String            @id @default(uuid())
  tenantId   String            @map("tenant_id")
  customerId String            @map("customer_id")
  type       CustomerEventType
  summary    String
  data       Json?             @db.JsonB
  actorId    String?           @map("actor_id")
  occurredAt DateTime          @default(now()) @map("occurred_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, occurredAt(sort: Desc)])
  @@index([tenantId, type, occurredAt(sort: Desc)])
  @@map("customer_events")
}

model CustomerAccount {
  id              String                @id @default(uuid())
  tenantId        String                @map("tenant_id")
  customerId      String                @unique @map("customer_id")
  loginIdentityId String?               @map("login_identity_id")
  status          CustomerAccountStatus @default(invited)
  passwordHash    String?               @map("password_hash")
  invitedAt       DateTime?             @map("invited_at")
  activatedAt     DateTime?             @map("activated_at")
  lastLoginAt     DateTime?             @map("last_login_at")
  lockedUntil     DateTime?             @map("locked_until")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loginIdentity CustomerIdentity? @relation(fields: [loginIdentityId], references: [id], onDelete: Restrict)

  @@unique([tenantId, loginIdentityId])
  @@index([tenantId, status])
  @@map("customer_accounts")
}

// ============================================================================
// BOOKINGS & PAYMENTS
// ============================================================================

model Booking {
  id                   String                 @id @default(uuid())
  tenantId             String                 @map("tenant_id")
  creationKey          String?                @map("creation_key")
  creationRequestHash  String?                @map("creation_request_hash")
  bookingNumber        String                 @map("booking_number")
  customerId           String                 @map("customer_id")
  quoteId              String?                @unique @map("quote_id")
  storefrontQuoteId    String?                @unique @map("storefront_quote_id")
  storefrontCartId     String?                @unique @map("storefront_cart_id")
  publicTrackingToken  String                 @unique @default(uuid()) @map("public_tracking_token")
  policyVersionId      String?                @map("policy_version_id") // Pricing Engine v2: frozen pricing snapshot
  channel              BookingChannel         @default(STOREFRONT)
  rentalStartDate      DateTime?              @map("rental_start_date") @db.Date
  rentalEndDate        DateTime?              @map("rental_end_date") @db.Date
  sourceLocationId     String?                @map("source_location_id")
  handoverMethod       BookingHandoverMethod? @map("handover_method")
  returnMethod         BookingReturnMethod?   @map("return_method")
  status               BookingStatus          @default(pending)
  paymentMethod        PaymentMethod          @map("payment_method")
  paymentStatus        PaymentStatus          @default(unpaid) @map("payment_status")
  subtotal             Int
  totalFees            Int                    @default(0) @map("total_fees")
  shippingFee          Int                    @default(0) @map("shipping_fee")
  totalDeposit         Int                    @default(0) @map("total_deposit")
  grandTotal           Int                    @map("grand_total")
  totalPaid            Int                    @default(0) @map("total_paid")
  discountAmount       Int                    @default(0) @map("discount_amount")
  discountType         String?                @map("discount_type") // 'flat' | 'percentage'
  discountReason       String?                @map("discount_reason")
  deliveryName         String                 @map("delivery_name")
  deliveryPhone        String                 @map("delivery_phone")
  deliveryAltPhone     String?                @map("delivery_alt_phone")
  deliveryAddressLine1 String                 @map("delivery_address_line1")
  deliveryAddressLine2 String?                @map("delivery_address_line2")
  deliveryCity         String                 @map("delivery_city")
  deliveryState        String?                @map("delivery_state")
  deliveryPostalCode   String?                @map("delivery_postal_code")
  deliveryCountry      String                 @map("delivery_country")
  deliveryExtra        Json?                  @map("delivery_extra") @db.JsonB
  customerNotes        String?                @map("customer_notes")
  internalNotes        String?                @map("internal_notes")
  cancellationReason   String?                @map("cancellation_reason")
  cancelledBy          CancelledBy?           @map("cancelled_by")
  cancelledAt          DateTime?              @map("cancelled_at")
  confirmedAt          DateTime?              @map("confirmed_at")
  deliveredAt          DateTime?              @map("delivered_at")
  returnedAt           DateTime?              @map("returned_at")
  completedAt          DateTime?              @map("completed_at")
  deletedAt            DateTime?              @map("deleted_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id])
  customer                    Customer                     @relation(fields: [customerId], references: [id])
  quote                       BookingQuote?                @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  storefrontQuote             StorefrontCheckoutQuote?     @relation(fields: [storefrontQuoteId], references: [id], onDelete: Restrict)
  storefrontCart              StorefrontCart?              @relation(fields: [storefrontCartId], references: [id], onDelete: Restrict)
  policyVersion               PricePolicyVersion?          @relation(fields: [policyVersionId], references: [id])
  sourceLocation              InventoryLocation?           @relation(fields: [sourceLocationId], references: [id], onDelete: Restrict)
  items                       BookingItem[]
  payments                    Payment[]
  inventoryReservations       InventoryReservation[]
  reviews                     Review[]
  FulfillmentRequirement      FulfillmentRequirement[]
  depositSettlements          DepositSettlement[]
  fulfillmentExtensions       FulfillmentExtension[]
  stockUnitRevenueAllocations StockUnitRevenueAllocation[]
  shipments                   Shipment[]
  versions                    BookingVersion[]
  fulfillmentGroups           FulfillmentGroup[]
  handovers                   Handover[]
  rentals                     Rental[]
  returnIntakes               ReturnIntake[]
  financialEntries            FinancialEntry[]
  operationalExceptions       OperationalException[]
  operationalTasks            OperationalTask[]
  closeCycles                 BookingCloseCycle[]
  operationalEvents           OperationalEvent[]

  @@unique([tenantId, bookingNumber])
  @@unique([tenantId, creationKey])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([customerId])
  @@index([tenantId, sourceLocationId, rentalStartDate, rentalEndDate])
  @@index([policyVersionId])
  @@map("bookings")
}

model Shipment {
  id                 String            @id @default(uuid())
  tenantId           String            @map("tenant_id")
  bookingId          String            @map("booking_id")
