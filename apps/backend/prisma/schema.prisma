  bookingVersionId         String?                      @map("booking_version_id")
  serviceOrderId           String?                      @map("service_order_id")
  inventoryBlockId         String?                      @unique @map("inventory_block_id")
  inspectionType           StockUnitInspectionType      @map("inspection_type")
  status                   StockUnitInspectionStatus    @default(DRAFT)
