  mainVariants  ProductVariant[] @relation("MainColor")
  variantColors VariantColor[]

  @@unique([name, tenantId])
  @@map("colors")
}

model SubscriptionPlan {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String? // Marketing description
  features         Json? // ["Feature 1", "Feature 2", ...]
  badge            String? // e.g. "Most Popular", "Best Value"
  priceMonthly     Int      @default(0) @map("price_monthly") // Paisa (ADR-04)
  priceAnnual      Int?     @map("price_annual") // Paisa (ADR-04)
  trialDays        Int      @default(0) @map("trial_days") // 0 = no trial
  maxProducts      Int?     @map("max_products")
  maxOrders        Int?     @map("max_orders")
  maxStaff         Int      @default(0) @map("max_staff")
  customDomain     Boolean  @default(false) @map("custom_domain")
  smsEnabled       Boolean  @default(false) @map("sms_enabled")
  analyticsFull    Boolean  @default(false) @map("analytics_full")
  removeBranding   Boolean  @default(false) @map("remove_branding")
  isActive         Boolean  @default(true) @map("is_active")
  displayOrder     Int      @default(0) @map("display_order")
  // Resource Governance Limits (null = unlimited)
  maxApiCallsDaily Int?     @map("max_api_calls_daily") // Daily API request quota per tenant
  maxStorageMb     Int?     @map("max_storage_mb") // MaxStorage in MB for product images
  maxRpm           Int      @default(120) @map("max_rpm") // Max requests per minute (noisy neighbor)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenants       Tenant[]
  subscriptions Subscription[]
  promoCodes    PromoCode[]
  history       SubscriptionHistory[] @relation("HistoryNewPlan")
  historyOld    SubscriptionHistory[] @relation("HistoryOldPlan")

  @@map("subscription_plans")
}

model StarterTemplate {
  id           String   @id @default(uuid())
  templateName String   @unique @map("template_name")
  data         Json
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
