// ============================================================================
// TENANT RESOURCE METERING (Governance & Observability)
// ============================================================================

// Hourly snapshots of per-tenant resource consumption.
// Written by the BullMQ aggregator job (metering.snapshotDaily).
// Provides historical trend data for the admin resource dashboard.
// One row per tenant per day (upserted hourly via @@unique constraint).
// 90 days of history retained (~50 tenants x 90 rows = 4,500 rows -- trivial).
model TenantUsageSnapshot {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  snapshotDate DateTime @map("snapshot_date") @db.Date // The day this snapshot covers

  // API Metrics -- aggregated from Redis counters
  apiRequestCount   Int @default(0) @map("api_request_count")
  avgResponseTimeMs Int @default(0) @map("avg_response_time_ms")
  p95ResponseTimeMs Int @default(0) @map("p95_response_time_ms") // Peak latency sample
  errorCount        Int @default(0) @map("error_count") // 4xx + 5xx count
  totalBandwidthKb  Int @default(0) @map("total_bandwidth_kb") // Response body sizes in KB
  peakRpm           Int @default(0) @map("peak_rpm") // Highest RPM observed

  // Resource Metrics -- computed by daily resource scan job
  productCount  Int @default(0) @map("product_count")
  bookingCount  Int @default(0) @map("booking_count")
  customerCount Int @default(0) @map("customer_count")
  staffCount    Int @default(0) @map("staff_count")
  storageUsedMb Int @default(0) @map("storage_used_mb") // Sum of product image file sizes

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, snapshotDate])
  @@index([snapshotDate]) // Fast range scans for dashboard time ranges
  @@index([tenantId, snapshotDate(sort: Desc)]) // Fast per-tenant history fetch
  @@map("tenant_usage_snapshots")
}

model StoreSettings {
  id                  String  @id @default(uuid())
  tenantId            String  @unique @map("tenant_id")
  primaryColor        String  @default("#6366F1") @map("primary_color")
  secondaryColor      String? @map("secondary_color")
  tagline             String?
  about               String?
  phone               String?
  whatsapp            String?
  email               String?
  address             String?
  facebookUrl         String? @map("facebook_url")
  instagramUrl        String? @map("instagram_url")
  tiktokUrl           String? @map("tiktok_url")
  youtubeUrl          String? @map("youtube_url")
  defaultLanguage     String  @default("en") @map("default_language")
  timezone            String  @default("UTC")
  country             String  @default("BD")
  currencyCode        String  @default("BDT") @map("currency_code")
  currencySymbol      String  @default("৳") @map("currency_symbol")
  currencyPosition    String  @default("before") @map("currency_position")
  numberFormat        String  @default("south_asian") @map("number_format")
  dateFormat          String  @default("DD/MM/YYYY") @map("date_format")
  timeFormat          String  @default("12h") @map("time_format")
  weekStart           String  @default("saturday") @map("week_start")
  smsEnabled          Boolean @default(true) @map("sms_enabled")
  bkashNumber         String? @map("bkash_number")
  nagadNumber         String? @map("nagad_number")
  sslcommerzStoreId   String? @map("sslcommerz_store_id")
  sslcommerzStorePass String? @map("sslcommerz_store_pass")
  sslcommerzSandbox   Boolean @default(true) @map("sslcommerz_sandbox")
  defaultCourier      String? @map("default_courier")
  courierApiKey       String? @map("courier_api_key")
  courierSecretKey    String? @map("courier_secret_key")
  pickupAddress       String? @map("pickup_address")
  pickupCity          String? @map("pickup_city")

  // Pathao-specific credentials (dedicated columns instead of pipe-delimited)
  pathaoClientId     String? @map("pathao_client_id")
  pathaoClientSecret String? @map("pathao_client_secret")
  pathaoUsername     String? @map("pathao_username")
  pathaoPassword     String? @map("pathao_password")
  pathaoStoreId      Int?    @map("pathao_store_id")
  pathaoSandbox      Boolean @default(false) @map("pathao_sandbox")

  // Pickup scheduling — district-based lead days
  pickupLeadDays       Int?  @default(2) @map("pickup_lead_days")
  pickupLeadDaysConfig Json? @map("pickup_lead_days_config") @db.JsonB

  maxConcurrentSessions Int      @default(5) @map("max_concurrent_sessions")
  bufferDays            Int      @default(0) @map("buffer_days")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("store_settings")
}

model TenantUser {
