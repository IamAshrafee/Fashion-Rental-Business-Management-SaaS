// ============================================================================
// PRODUCT & CATALOG
// ============================================================================

model Product {
  id                   String                       @id @default(uuid())
  tenantId             String                       @map("tenant_id")
  creationKey          String?                      @map("creation_key")
  name                 String
  slug                 String
  description          String?
  categoryId           String                       @map("category_id")
  subcategoryId        String?                      @map("subcategory_id")
  productTypeId        String?                      @map("product_type_id")
  sizeSchemaOverrideId String?                      @map("size_schema_override_id")
  status               ProductStatus                @default(draft)
  isAvailable          Boolean                      @default(true) @map("is_available")
  availableFrom        DateTime?                    @map("available_from") @db.Date
  unavailableReason    String?                      @map("unavailable_reason")
  purchaseDate         DateTime?                    @map("purchase_date") @db.Date
  purchasePrice        Int?                         @map("purchase_price")
  purchasePricePublic  Boolean                      @default(false) @map("purchase_price_public")
  itemCountry          String?                      @map("item_country")
  itemCountryPublic    Boolean                      @default(false) @map("item_country_public")
  targetRentals        Int?                         @map("target_rentals")
  storefrontItemMode   StorefrontItemVisibilityMode @default(INTERNAL_ONLY) @map("storefront_item_mode")
  totalBookings        Int                          @default(0) @map("total_bookings")
  totalRevenue         Int                          @default(0) @map("total_revenue")
  popularityScore      Int                          @default(0) @map("popularity_score")
  searchVector         Unsupported("tsvector")?     @map("search_vector")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")
  deletedAt            DateTime?                    @map("deleted_at")
  deletedByUserId      String?                      @map("deleted_by_user_id")

  tenant                        Tenant                          @relation(fields: [tenantId], references: [id])
  deletedBy                     User?                           @relation("ProductDeletedBy", fields: [deletedByUserId], references: [id])
  category                      Category                        @relation(fields: [categoryId], references: [id])
  subcategory                   Subcategory?                    @relation(fields: [subcategoryId], references: [id])
  productType                   ProductType?                    @relation(fields: [productTypeId], references: [id])
  sizeSchemaOverride            SizeSchema?                     @relation("ProductSchemaOverride", fields: [sizeSchemaOverrideId], references: [id])
  variants                      ProductVariant[]
  events                        ProductEvent[]
  pricingProfile                PricingProfile?
  faqs                          ProductFaq[]
  detailHeaders                 ProductDetailHeader[]
  bookingItems                  BookingItem[]
  inventoryReservations         InventoryReservation[]
  inventoryBlocks               InventoryBlock[]
  reviews                       Review[]
  sizeCharts                    SizeChart[]
  storefrontEvents              StorefrontEvent[]
  compositionRules              ProductCompositionRule[]        @relation("CompositionParent")
  usedInCompositionRules        ProductCompositionRule[]        @relation("CompositionComponent")
  compositionAlternatives       ProductCompositionAlternative[]
  fulfillmentRequirements       FulfillmentRequirement[]
  fulfillmentSelectionSnapshots FulfillmentSelectionSnapshot[]
  availabilityPolicies          AvailabilityPolicy[]

  @@unique([tenantId, slug])
  @@unique([tenantId, creationKey])
  @@index([categoryId])
  @@index([productTypeId])
  @@index([sizeSchemaOverrideId])
  @@index([tenantId, status])
  @@index([tenantId, status, popularityScore])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  productId   String   @map("product_id")
  variantName String?  @map("variant_name")
  mainColorId String   @map("main_color_id")
  sequence    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  mainColor       Color            @relation("MainColor", fields: [mainColorId], references: [id])
  identicalColors VariantColor[]
  images          ProductImage[]
  sizes           VariantSize[]
  inventoryBlocks InventoryBlock[]

  @@index([productId])
  @@index([tenantId])
  @@map("product_variants")
}

model VariantSize {
  id               String                @id @default(uuid())
  tenantId         String                @map("tenant_id")
  variantId        String                @map("variant_id")
  sizeInstanceId   String                @map("size_instance_id")
  trackingMode     InventoryTrackingMode @default(POOLED) @map("tracking_mode")
  inventoryVersion Int                   @default(0) @map("inventory_version")

  tenant                        Tenant                          @relation(fields: [tenantId], references: [id])
  variant                       ProductVariant                  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sizeInstance                  SizeInstance                    @relation(fields: [sizeInstanceId], references: [id])
  stockUnits                    StockUnit[]
  inventoryReservations         InventoryReservation[]
  inventoryMovements            InventoryMovement[]
  inventoryBlocks               InventoryBlock[]
  bookingItems                  BookingItem[]
  setComponentDefinitions       SkuSetComponentDefinition[]
  fixedCompositionRules         ProductCompositionRule[]
  compositionAlternatives       ProductCompositionAlternative[]
  fulfillmentRequirements       FulfillmentRequirement[]
  fulfillmentSelectionSnapshots FulfillmentSelectionSnapshot[]
  inventoryPools                InventoryPool[]
  availabilityPolicies          AvailabilityPolicy[]
  inventoryTransferLines        InventoryTransferLine[]

  @@unique([variantId, sizeInstanceId])
  @@index([variantId])
  @@index([tenantId, trackingMode])
  @@map("variant_sizes")
}

model VariantColor {
  id        String @id @default(uuid())
  variantId String @map("variant_id")
  colorId   String @map("color_id")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  color   Color          @relation(fields: [colorId], references: [id])

  @@unique([variantId, colorId])
  @@index([colorId])
  @@map("variant_colors")
}

model ProductImage {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  variantId    String   @map("variant_id")
  url          String
  thumbnailUrl String   @map("thumbnail_url")
  isFeatured   Boolean  @default(false) @map("is_featured")
  sequence     Int      @default(0)
  originalName String?  @map("original_name")
  fileSize     Int?     @map("file_size")
  createdAt    DateTime @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([tenantId])
  @@index([variantId, sequence])
  @@map("product_images")
}

model ProductDetailHeader {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  productId  String   @map("product_id")
  headerName String   @map("header_name")
  sequence   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  entries ProductDetailEntry[]

  @@index([productId])
  @@map("product_detail_headers")
}

model ProductDetailEntry {
  id       String @id @default(uuid())
  headerId String @map("header_id")
  key      String
  value    String
  sequence Int    @default(0)

  header ProductDetailHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)

  @@index([headerId])
  @@map("product_detail_entries")
}

// ============================================================================
// PRICING ENGINE v2 — Composable, Versioned Pricing
// ============================================================================

model PricingProfile {
  id                    String          @id @default(uuid())
  tenantId              String          @map("tenant_id")
  productId             String          @unique @map("product_id")
  currency              String          @default("BDT") @db.Char(3)
  timezone              String          @default("Asia/Dhaka")
  durationMode          DurationMode    @default(CALENDAR_DAYS) @map("duration_mode")
  billingRounding       BillingRounding @default(CEIL) @map("billing_rounding")
  activePolicyVersionId String?         @map("active_policy_version_id")
  headlinePriceMinor    Int             @default(0) @map("headline_price_minor")
  headlineLabel         String?         @map("headline_label")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  policyVersions PricePolicyVersion[]

  @@index([tenantId])
  @@index([tenantId, headlinePriceMinor])
  @@map("pricing_profiles")
}

model PricePolicyVersion {
  id                 String              @id @default(uuid())
  pricingProfileId   String              @map("pricing_profile_id")
  version            Int
  status             PolicyVersionStatus @default(DRAFT)
  effectiveFrom      DateTime?           @map("effective_from") @db.Timestamptz
  effectiveTo        DateTime?           @map("effective_to") @db.Timestamptz
  publishedAt        DateTime?           @map("published_at") @db.Timestamptz
  snapshotConfig     Json?               @map("snapshot_config") @db.JsonB
  lateFeePolicy      Json?               @map("late_fee_policy") @db.JsonB
  presentationConfig Json?               @map("presentation_config") @db.JsonB
  createdBy          String?             @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at")

  pricingProfile  PricingProfile   @relation(fields: [pricingProfileId], references: [id], onDelete: Cascade)
  ratePlans       RatePlan[]
  priceComponents PriceComponent[]
  quotes          Quote[]
  bookings        Booking[]

  @@index([pricingProfileId, status, version(sort: Desc)])
  @@map("price_policy_versions")
}

model RatePlan {
  id              String       @id @default(uuid())
  policyVersionId String       @map("policy_version_id")
  type            RatePlanType
  priority        Int          @default(100)
  config          Json         @db.JsonB
  createdAt       DateTime     @default(now()) @map("created_at")

  policyVersion PricePolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  conditionSet  ConditionSet?

  @@index([policyVersionId, priority(sort: Desc)])
  @@map("rate_plans")
}

model PriceComponent {
  id              String              @id @default(uuid())
  policyVersionId String              @map("policy_version_id")
  type            ComponentType
  priority        Int                 @default(100)
  visibility      ComponentVisibility @default(CUSTOMER)
  chargeTiming    ChargeTiming        @default(AT_BOOKING) @map("charge_timing")
  refundable      Boolean             @default(false)
  exclusiveGroup  String?             @map("exclusive_group")
  config          Json                @db.JsonB
  createdAt       DateTime            @default(now()) @map("created_at")

  policyVersion PricePolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  conditionSet  ConditionSet?

  @@index([policyVersionId, priority(sort: Desc)])
  @@map("price_components")
}

model ConditionSet {
  id          String  @id @default(uuid())
  ratePlanId  String? @unique @map("rate_plan_id")
  componentId String? @unique @map("component_id")

  ratePlan   RatePlan?       @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  component  PriceComponent? @relation(fields: [componentId], references: [id], onDelete: Cascade)
  conditions Condition[]

  @@map("condition_sets")
}

model Condition {
  id             String            @id @default(uuid())
  conditionSetId String            @map("condition_set_id")
  field          String // e.g. 'date_range', 'dow', 'customer_tier', 'channel', 'location', 'duration_days'
  operator       ConditionOperator
  value          Json              @db.JsonB

  conditionSet ConditionSet @relation(fields: [conditionSetId], references: [id], onDelete: Cascade)

  @@index([conditionSetId])
  @@map("conditions")
}

model Quote {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  productId          String   @map("product_id")
  variantId          String?  @map("variant_id")
  policyVersionId    String   @map("policy_version_id")
  startAt            DateTime @map("start_at") @db.Timestamptz
  endAt              DateTime @map("end_at") @db.Timestamptz
  customerContext    Json?    @map("customer_context") @db.JsonB
  selectedAddons     Json?    @map("selected_addons") @db.JsonB
  inputsHash         String   @map("inputs_hash")
  currency           String   @default("BDT") @db.Char(3)
  billableDays       Int      @map("billable_days")
  subtotalMinor      Int      @map("subtotal_minor")
  depositMinor       Int      @map("deposit_minor")
  totalDueNowMinor   Int      @map("total_due_now_minor")
  totalDueLaterMinor Int      @map("total_due_later_minor")
  expiresAt          DateTime @map("expires_at") @db.Timestamptz
  createdAt          DateTime @default(now()) @map("created_at")

  policyVersion PricePolicyVersion @relation(fields: [policyVersionId], references: [id])
  lineItems     QuoteLineItem[]

  @@index([tenantId, inputsHash])
  @@map("quotes")
}

model QuoteLineItem {
  id          String              @id @default(uuid())
  quoteId     String              @map("quote_id")
  type        String // e.g. 'BASE_RENTAL', 'CLEANING_FEE', 'DEPOSIT', 'DISCOUNT'
  label       String
  amountMinor Int                 @map("amount_minor")
  refundable  Boolean             @default(false)
  visibility  ComponentVisibility @default(CUSTOMER)
  metadata    Json?               @db.JsonB

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_line_items")
}

// ============================================================================
// SIZING MODULE — Schema-Driven Architecture
// ============================================================================

model ProductType {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  name                String
  slug                String
  description         String?  @db.VarChar(255)
  defaultSizeSchemaId String?  @map("default_size_schema_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  defaultSizeSchema SizeSchema? @relation(fields: [defaultSizeSchemaId], references: [id])
  products          Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([defaultSizeSchemaId])
  @@map("product_types")
}

model SizeSchema {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  code        String
  name        String
  description String?          @db.VarChar(255)
  schemaType  String           @default("STANDARD") @map("schema_type")
  status      SizeSchemaStatus @default(draft)
  definition  Json             @default("{}") @db.JsonB
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  instances              SizeInstance[]
  productTypes           ProductType[]
  productSchemaOverrides Product[]      @relation("ProductSchemaOverride")
  sizeCharts             SizeChart[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("size_schemas")
}

model SizeInstance {
  id            String   @id @default(uuid())
  sizeSchemaId  String   @map("size_schema_id")
  normalizedKey String   @map("normalized_key")
  displayLabel  String   @map("display_label")
  payload       Json     @default("{}") @db.JsonB
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sizeSchema   SizeSchema    @relation(fields: [sizeSchemaId], references: [id])
  variantSizes VariantSize[]

  @@unique([sizeSchemaId, normalizedKey])
  @@index([sizeSchemaId])
  @@map("size_instances")
}

model SizeChart {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  sizeSchemaId String   @map("size_schema_id")
  productId    String?  @map("product_id")
  title        String   @default("Size Guide")
  chartMeta    Json     @default("{}") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sizeSchema SizeSchema     @relation(fields: [sizeSchemaId], references: [id])
  product    Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  rows       SizeChartRow[]

  @@index([tenantId])
  @@index([sizeSchemaId])
  @@index([productId])
  @@map("size_charts")
}

model SizeChartRow {
  id           String @id @default(uuid())
  sizeChartId  String @map("size_chart_id")
  sizeLabel    String @map("size_label")
  measurements Json   @default("{}") @db.JsonB
  sortOrder    Int    @default(0) @map("sort_order")

  sizeChart SizeChart @relation(fields: [sizeChartId], references: [id], onDelete: Cascade)

  @@index([sizeChartId, sortOrder])
  @@map("size_chart_rows")
}

// ============================================================================
// CATEGORIES & EVENTS
// ============================================================================

model Category {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  slug         String
  icon         String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  subcategories Subcategory[]
  products      Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model Subcategory {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  categoryId   String   @map("category_id")
  name         String
  slug         String
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  category Category  @relation(fields: [categoryId], references: [id])
  products Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([tenantId])
  @@map("subcategories")
}

model Event {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  slug         String
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  products ProductEvent[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("events")
}

model ProductEvent {
  id        String @id @default(uuid())
  productId String @map("product_id")
  eventId   String @map("event_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([productId, eventId])
  @@index([eventId])
  @@map("product_events")
}

model ProductFaq {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  productId String   @map("product_id")
  question  String
  answer    String
  sequence  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([tenantId])
  @@map("product_faqs")
}

// ============================================================================
// CUSTOMERS
// ============================================================================

model Customer {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  fullName      String    @map("full_name")
  phone         String
  altPhone      String?   @map("alt_phone")
  email         String?
  addressLine1  String?   @map("address_line1")
  addressLine2  String?   @map("address_line2")
  city          String?
  state         String?
  postalCode    String?   @map("postal_code")
  country       String?
  addressExtra  Json?     @map("address_extra") @db.JsonB
  notes         String?
  totalBookings Int       @default(0) @map("total_bookings")
  totalSpent    Int       @default(0) @map("total_spent")
  lastBookingAt DateTime? @map("last_booking_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  bookings Booking[]
  tags     CustomerTag[]
  reviews  Review[]

  @@unique([tenantId, phone])
  @@index([tenantId, fullName])
  @@map("customers")
}

model CustomerTag {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  customerId String @map("customer_id")
  tag        String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, tag])
  @@index([tenantId])
  @@map("customer_tags")
}

// ============================================================================
// BOOKINGS & PAYMENTS
// ============================================================================

model Booking {
  id                   String        @id @default(uuid())
  tenantId             String        @map("tenant_id")
  creationKey          String?       @map("creation_key")
  creationRequestHash  String?       @map("creation_request_hash")
  bookingNumber        String        @map("booking_number")
  customerId           String        @map("customer_id")
  policyVersionId      String?       @map("policy_version_id") // Pricing Engine v2: frozen pricing snapshot
  status               BookingStatus @default(pending)
  paymentMethod        PaymentMethod @map("payment_method")
  paymentStatus        PaymentStatus @default(unpaid) @map("payment_status")
  subtotal             Int
  totalFees            Int           @default(0) @map("total_fees")
  shippingFee          Int           @default(0) @map("shipping_fee")
  totalDeposit         Int           @default(0) @map("total_deposit")
  grandTotal           Int           @map("grand_total")
  totalPaid            Int           @default(0) @map("total_paid")
  discountAmount       Int           @default(0) @map("discount_amount")
  discountType         String?       @map("discount_type") // 'flat' | 'percentage'
  discountReason       String?       @map("discount_reason")
  deliveryName         String        @map("delivery_name")
  deliveryPhone        String        @map("delivery_phone")
  deliveryAltPhone     String?       @map("delivery_alt_phone")
  deliveryAddressLine1 String        @map("delivery_address_line1")
  deliveryAddressLine2 String?       @map("delivery_address_line2")
  deliveryCity         String        @map("delivery_city")
  deliveryState        String?       @map("delivery_state")
  deliveryPostalCode   String?       @map("delivery_postal_code")
  deliveryCountry      String        @map("delivery_country")
  deliveryExtra        Json?         @map("delivery_extra") @db.JsonB
  customerNotes        String?       @map("customer_notes")
  internalNotes        String?       @map("internal_notes")
  trackingNumber       String?       @map("tracking_number")
  courierProvider      String?       @map("courier_provider")
  courierConsignmentId String?       @map("courier_consignment_id")
  courierStatus        String?       @map("courier_status")
  courierStatusHistory Json?         @map("courier_status_history") @db.JsonB
  pickupRequestedAt    DateTime?     @map("pickup_requested_at")
  pickupJobId          String?       @map("pickup_job_id")
  scheduledPickupAt    DateTime?     @map("scheduled_pickup_at")
  deliveryLeadDays     Int?          @map("delivery_lead_days")
  courierErrorReason   String?       @map("courier_error_reason")
  cancellationReason   String?       @map("cancellation_reason")
  cancelledBy          CancelledBy?  @map("cancelled_by")
  cancelledAt          DateTime?     @map("cancelled_at")
  confirmedAt          DateTime?     @map("confirmed_at")
  deliveredAt          DateTime?     @map("delivered_at")
  returnedAt           DateTime?     @map("returned_at")
  completedAt          DateTime?     @map("completed_at")
  deletedAt            DateTime?     @map("deleted_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  tenant                 Tenant                   @relation(fields: [tenantId], references: [id])
  customer               Customer                 @relation(fields: [customerId], references: [id])
  policyVersion          PricePolicyVersion?      @relation(fields: [policyVersionId], references: [id])
  items                  BookingItem[]
  payments               Payment[]
  inventoryReservations  InventoryReservation[]
  reviews                Review[]
  FulfillmentRequirement FulfillmentRequirement[]

  @@unique([tenantId, bookingNumber])
  @@unique([tenantId, creationKey])
  @@index([tenantId, status])
  @@index([tenantId, courierStatus])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([customerId])
  @@index([policyVersionId])
  @@map("bookings")
}

model BookingItem {
  id                  String        @id @default(uuid())
  tenantId            String        @map("tenant_id")
  bookingId           String        @map("booking_id")
  productId           String?       @map("product_id")
  variantId           String        @map("variant_id")
  variantSizeId       String?       @map("variant_size_id")
  quantity            Int           @default(1)
  productName         String        @map("product_name")
  variantName         String?       @map("variant_name")
  colorName           String        @map("color_name")
  sizeInfo            String?       @map("size_info")
  featuredImageUrl    String        @map("featured_image_url")
  startDate           DateTime      @map("start_date") @db.Date
  endDate             DateTime      @map("end_date") @db.Date
  rentalDays          Int           @map("rental_days")
  baseRental          Int           @map("base_rental")
  extendedDays        Int           @default(0) @map("extended_days")
  extendedCost        Int           @default(0) @map("extended_cost")
  depositAmount       Int           @default(0) @map("deposit_amount")
  depositStatus       DepositStatus @default(pending) @map("deposit_status")
  depositRefundAmount Int?          @map("deposit_refund_amount")
  depositRefundDate   DateTime?     @map("deposit_refund_date")
  depositRefundMethod String?       @map("deposit_refund_method")
  cleaningFee         Int           @default(0) @map("cleaning_fee")
  backupSize          String?       @map("backup_size")
  backupSizeFee       Int           @default(0) @map("backup_size_fee")
  tryOnFee            Int           @default(0) @map("try_on_fee")
  tryOnCredited       Boolean       @default(false) @map("try_on_credited")
  itemTotal           Int           @map("item_total")
  lateFee             Int           @default(0) @map("late_fee")
