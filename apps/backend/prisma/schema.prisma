  inspectionCheckId String?               @map("inspection_check_id")
  issueId           String?               @map("issue_id")
  serviceOrderId    String?               @map("service_order_id")
  purpose           InventoryMediaPurpose
  url               String
  objectKey         String?               @map("object_key")
  mimeType          String?               @map("mime_type")
  caption           String?
  isPublicApproved  Boolean               @default(false) @map("is_public_approved")
  uploadedByUserId  String                @map("uploaded_by_user_id")
  capturedAt        DateTime?             @map("captured_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  tenant          Tenant                    @relation(fields: [tenantId], references: [id])
  stockUnit       StockUnit?                @relation(fields: [stockUnitId], references: [id], onDelete: Cascade)
  inspection      StockUnitInspection?      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionCheck StockUnitInspectionCheck? @relation(fields: [inspectionCheckId], references: [id], onDelete: Cascade)
  issue           StockUnitIssue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  serviceOrder    InventoryServiceOrder?    @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  uploadedBy      User                      @relation("InventoryMediaUploader", fields: [uploadedByUserId], references: [id])

  @@index([tenantId, stockUnitId, createdAt(sort: Desc)])
  @@index([inspectionId])
  @@index([inspectionCheckId])
  @@index([issueId])
  @@index([serviceOrderId])
  @@index([uploadedByUserId])
  @@map("inventory_media_attachments")
}

model Payment {
  id               String            @id @default(uuid())
  tenantId         String            @map("tenant_id")
  bookingId        String            @map("booking_id")
  amount           Int
  method           PaymentMethod
  status           TransactionStatus @default(pending)
  transactionId    String?           @map("transaction_id")
  providerResponse Json?             @map("provider_response")
  verifiedAt       DateTime?         @map("verified_at")
  refundedAt       DateTime?         @map("refunded_at")
  refundAmount     Int?              @map("refund_amount")
  notes            String?
  recordedBy       String?           @map("recorded_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([tenantId])
  @@index([transactionId])
  @@map("payments")
}

model Review {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  productId  String   @map("product_id")
  customerId String   @map("customer_id")
  bookingId  String   @map("booking_id")
  rating     Int
  comment    String?
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  booking  Booking  @relation(fields: [bookingId], references: [id])

  @@unique([bookingId, productId])
  @@index([productId])
  @@index([tenantId])
  @@map("reviews")
}

// ============================================================================
// SYSTEM
// ============================================================================

model Notification {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  userId    String?   @map("user_id")
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId])
  @@index([tenantId, isRead])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model FailedJob {
  id        String    @id @default(uuid())
  queue     String
  jobName   String    @map("job_name")
  payload   Json
  error     String
  failedAt  DateTime  @map("failed_at")
  retriedAt DateTime? @map("retried_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([queue])
  @@index([failedAt])
  @@map("failed_jobs")
}

// ============================================================================
// PLATFORM BILLING (SaaS Admin → Tenant)
// ============================================================================

model SubscriptionPayment {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  amount      Int // Paisa (ADR-04)
  method      String // 'bkash', 'nagad', 'bank_transfer', 'cash'
  reference   String? // Transaction ID or receipt number
  notes       String?
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  recordedBy  String   @map("recorded_by") // Admin user ID
  createdAt   DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  recorder User     @relation("PaymentsRecordedBy", fields: [recordedBy], references: [id])
  invoice  Invoice?

  @@index([tenantId])
  @@index([recordedBy])
  @@map("subscription_payments")
}

model Invoice {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  paymentId String?   @unique @map("payment_id")
  invoiceNo String    @unique @map("invoice_no") // INV-2026-0001
  amount    Int // Paisa (ADR-04)
  status    String    @default("unpaid") // unpaid, paid, void
  dueDate   DateTime  @map("due_date")
  paidAt    DateTime? @map("paid_at")
  lineItems Json      @map("line_items") // [{desc, qty, rate, amount}]
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant  Tenant               @relation(fields: [tenantId], references: [id])
  payment SubscriptionPayment? @relation(fields: [paymentId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("invoices")
}

model PromoCode {
  id           String    @id @default(uuid())
  code         String    @unique // 'LAUNCH2026'
  linkedPlanId String?   @map("linked_plan_id") // Auto-assign this plan
  trialDays    Int?      @map("trial_days") // Override default trial
  discountPct  Int?      @map("discount_pct") // For future use
  maxUses      Int?      @map("max_uses") // null = unlimited
  currentUses  Int       @default(0) @map("current_uses")
  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  createdBy    String    @map("created_by") // Admin user ID
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  linkedPlan SubscriptionPlan? @relation(fields: [linkedPlanId], references: [id])
  creator    User              @relation("PromoCodesCreatedBy", fields: [createdBy], references: [id])
  tenants    Tenant[]

  @@map("promo_codes")
}

model SubscriptionHistory {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  oldPlanId    String?  @map("old_plan_id")
  newPlanId    String   @map("new_plan_id")
  action       String // 'created', 'upgraded', 'downgraded', 'renewed', 'extended', 'cancelled'
  billingCycle String?  @map("billing_cycle") // 'monthly', 'annual'
  reason       String?
  performedBy  String   @map("performed_by") // Admin or 'system'
  metadata     Json? // Extra context
  createdAt    DateTime @default(now()) @map("created_at")

  tenant  Tenant            @relation(fields: [tenantId], references: [id])
  oldPlan SubscriptionPlan? @relation("HistoryOldPlan", fields: [oldPlanId], references: [id])
  newPlan SubscriptionPlan  @relation("HistoryNewPlan", fields: [newPlanId], references: [id])
  actor   User              @relation("HistoryPerformedBy", fields: [performedBy], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("subscription_history")
}

// ============================================================================
// STOREFRONT ANALYTICS (Events tracking)
// ============================================================================

model StorefrontEvent {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  sessionId String @map("session_id") // UUID stored in the buyer's browser
  eventType String @map("event_type") // 'product_view', 'add_to_cart', 'remove_from_cart', 'checkout_started'

  productId String? @map("product_id")
  variantId String? @map("variant_id")

  metadata Json? // Optional: source url, time spent on page, cart value, etc.

  ipAddress String?  @map("ip_address") // Crucial for bot protection
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Compound indexes for lightning-fast dashboard queries over millions of rows
  @@index([tenantId, eventType, createdAt])
  @@index([productId, eventType])
  @@index([sessionId])
  @@map("storefront_events")
}
