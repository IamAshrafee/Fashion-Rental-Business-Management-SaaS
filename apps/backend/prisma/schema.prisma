model User {
  id           String    @id @default(uuid())
  fullName     String    @map("full_name")
  email        String?   @unique
  phone        String?
  passwordHash String    @map("password_hash")
  role         UserRole  @default(owner)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  ownedTenants                 Tenant[]
  tenantUsers                  TenantUser[]
  auditLogs                    AuditLog[]
  sessions                     Session[]
  loginHistory                 LoginHistory[]
  damageReports                DamageReport[]
  deletedProducts              Product[]                       @relation("ProductDeletedBy")
  recordedPayments             SubscriptionPayment[]           @relation("PaymentsRecordedBy")
  createdPromoCodes            PromoCode[]                     @relation("PromoCodesCreatedBy")
  subscriptionActions          SubscriptionHistory[]           @relation("HistoryPerformedBy")
  createdInventoryBlocks       InventoryBlock[]                @relation("InventoryBlockCreatedBy")
  inventoryMovements           InventoryMovement[]             @relation("InventoryMovementActor")
  stockUnitAssignments         StockUnitAssignment[]           @relation("StockUnitAssignedBy")
  stockUnitLifecycleEvents     StockUnitLifecycleEvent[]       @relation("StockUnitLifecycleActor")
  stockUnitInspections         StockUnitInspection[]           @relation("StockUnitInspectionActor")
  reportedStockUnitIssues      StockUnitIssue[]                @relation("StockUnitIssueReporter")
  resolvedStockUnitIssues      StockUnitIssue[]                @relation("StockUnitIssueResolver")
  requestedServiceOrders       InventoryServiceOrder[]         @relation("ServiceOrderRequester")
  completedServiceOrders       InventoryServiceOrder[]         @relation("ServiceOrderCompleter")
  createdSetComponents         SkuSetComponentDefinition[]     @relation("SetComponentCreator")
  inventoryMediaUploads        InventoryMediaAttachment[]      @relation("InventoryMediaUploader")
  createdCompositionRules      ProductCompositionRule[]        @relation("CompositionRuleCreator")
  fulfillmentVersions          FulfillmentRequirementVersion[] @relation("FulfillmentVersionActor")
  fulfillmentSubstitutions     FulfillmentSubstitution[]       @relation("FulfillmentSubstitutionActor")
  fulfillmentEvents            FulfillmentRequirementEvent[]   @relation("FulfillmentEventActor")
  createdInventoryLocations    InventoryLocation[]             @relation("InventoryLocationCreator")
  createdInventoryTransfers    InventoryTransfer[]             @relation("InventoryTransferCreator")
  approvedInventoryTransfers   InventoryTransfer[]             @relation("InventoryTransferApprover")
  dispatchedInventoryTransfers InventoryTransfer[]             @relation("InventoryTransferDispatcher")
  receivedInventoryTransfers   InventoryTransfer[]             @relation("InventoryTransferReceiver")
  inventoryTransferEvents      InventoryTransferEvent[]        @relation("InventoryTransferEventActor")

  @@index([phone])
  @@map("users")
}

model Color {
  id        String   @id @default(uuid())
