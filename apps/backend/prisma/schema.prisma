// ============================================================================
// ClosetRent — Complete Prisma Schema
// ============================================================================
// All 35 tables, all enums, all indexes, all relationships.
// Conventions:
//   - PK: UUID v4, @default(uuid())
//   - Table names: @@map("snake_case")
//   - Column names: @map("snake_case")
//   - Money fields: Int (never Decimal) — see ADR-04
//   - Tenant-scoped tables have tenantId FK
//   - Soft-delete: deletedAt DateTime? on products, bookings, customers
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

