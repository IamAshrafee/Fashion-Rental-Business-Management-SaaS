model User {
  id           String    @id @default(uuid())
  fullName     String    @map("full_name")
  email        String?   @unique
  phone        String?   @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(owner)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  ownedTenants                  Tenant[]
  tenantUsers                   TenantUser[]
  auditLogs                     AuditLog[]
  sessions                      Session[]
  impersonatedSessions          Session[]                       @relation("SessionImpersonator")
  loginHistory                  LoginHistory[]
  passwordResetTokens           PasswordResetToken[]
  damageReports                 DamageReport[]
  deletedProducts               Product[]                       @relation("ProductDeletedBy")
  createdProductOnboardings     ProductOnboarding[]             @relation("ProductOnboardingCreator")
  updatedProductOnboardings     ProductOnboarding[]             @relation("ProductOnboardingUpdater")
  productOnboardingCommands     ProductOnboardingCommand[]
  recordedPayments              SubscriptionPayment[]           @relation("PaymentsRecordedBy")
  createdPromoCodes             PromoCode[]                     @relation("PromoCodesCreatedBy")
  subscriptionActions           SubscriptionHistory[]           @relation("HistoryPerformedBy")
  createdInventoryBlocks        InventoryBlock[]                @relation("InventoryBlockCreatedBy")
  inventoryMovements            InventoryMovement[]             @relation("InventoryMovementActor")
  createdInventoryCounts        InventoryCountSession[]         @relation("InventoryCountCreator")
  completedInventoryCounts      InventoryCountSession[]         @relation("InventoryCountCompleter")
  stockUnitAssignments          StockUnitAssignment[]           @relation("StockUnitAssignedBy")
  stockUnitLifecycleEvents      StockUnitLifecycleEvent[]       @relation("StockUnitLifecycleActor")
  stockUnitInspections          StockUnitInspection[]           @relation("StockUnitInspectionActor")
  reportedStockUnitIssues       StockUnitIssue[]                @relation("StockUnitIssueReporter")
  resolvedStockUnitIssues       StockUnitIssue[]                @relation("StockUnitIssueResolver")
  requestedServiceOrders        InventoryServiceOrder[]         @relation("ServiceOrderRequester")
  completedServiceOrders        InventoryServiceOrder[]         @relation("ServiceOrderCompleter")
  createdSetComponents          SkuSetComponentDefinition[]     @relation("SetComponentCreator")
  inventoryMediaUploads         InventoryMediaAttachment[]      @relation("InventoryMediaUploader")
  createdCompositionRules       ProductCompositionRule[]        @relation("CompositionRuleCreator")
  fulfillmentVersions           FulfillmentRequirementVersion[] @relation("FulfillmentVersionActor")
  fulfillmentSubstitutions      FulfillmentSubstitution[]       @relation("FulfillmentSubstitutionActor")
  fulfillmentExtensions         FulfillmentExtension[]          @relation("FulfillmentExtensionActor")
  fulfillmentEvents             FulfillmentRequirementEvent[]   @relation("FulfillmentEventActor")
  depositSettlements            DepositSettlement[]             @relation("DepositSettlementActor")
  recordedBookingPayments       Payment[]                       @relation("BookingPaymentRecorder")
  createdInventoryLocations     InventoryLocation[]             @relation("InventoryLocationCreator")
  createdInventoryTransfers     InventoryTransfer[]             @relation("InventoryTransferCreator")
  approvedInventoryTransfers    InventoryTransfer[]             @relation("InventoryTransferApprover")
  dispatchedInventoryTransfers  InventoryTransfer[]             @relation("InventoryTransferDispatcher")
  receivedInventoryTransfers    InventoryTransfer[]             @relation("InventoryTransferReceiver")
  inventoryTransferEvents       InventoryTransferEvent[]        @relation("InventoryTransferEventActor")
  stockUnitRevenueAllocations   StockUnitRevenueAllocation[]    @relation("StockUnitRevenueAllocationActor")
  reconciledCodRemittances      CodRemittance[]                 @relation("CodRemittanceReconciler")
  createdStaffInvitations       StaffInvitation[]               @relation("StaffInvitationCreator")
  bookingVersions               BookingVersion[]                @relation("BookingVersionActor")
  custodyEvents                 CustodyEvent[]                  @relation("CustodyEventActor")
  completedHandovers            Handover[]                      @relation("HandoverActor")
  returnIntakes                 ReturnIntake[]                  @relation("ReturnIntakeActor")
  financialEntries              FinancialEntry[]                @relation("FinancialEntryActor")
  createdOperationalExceptions  OperationalException[]          @relation("OperationalExceptionCreator")
  assignedOperationalExceptions OperationalException[]          @relation("OperationalExceptionAssignee")
  resolvedOperationalExceptions OperationalException[]          @relation("OperationalExceptionResolver")
  assignedOperationalTasks      OperationalTask[]               @relation("OperationalTaskAssignee")
  completedOperationalTasks     OperationalTask[]               @relation("OperationalTaskCompleter")
  bookingCloseCycles            BookingCloseCycle[]             @relation("BookingCloseCycleActor")
  operationalEvents             OperationalEvent[]              @relation("OperationalEventActor")

  @@map("users")
}

model Color {
  id        String   @id @default(uuid())
  systemKey String?  @unique @map("system_key")
  name      String
  hexCode   String   @map("hex_code")
  isSystem  Boolean  @default(false) @map("is_system")
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mainVariants  ProductVariant[] @relation("MainColor")
  variantColors VariantColor[]

  @@unique([name, tenantId])
  @@map("colors")
}

model SubscriptionPlan {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String? // Marketing description
  features         Json? // ["Feature 1", "Feature 2", ...]
  badge            String? // e.g. "Most Popular", "Best Value"
  priceMonthly     Int      @default(0) @map("price_monthly") // Paisa (ADR-04)
  priceAnnual      Int?     @map("price_annual") // Paisa (ADR-04)
  trialDays        Int      @default(0) @map("trial_days") // 0 = no trial
  maxProducts      Int?     @map("max_products")
  maxOrders        Int?     @map("max_orders")
  maxStaff         Int      @default(0) @map("max_staff")
  customDomain     Boolean  @default(false) @map("custom_domain")
  smsEnabled       Boolean  @default(false) @map("sms_enabled")
  analyticsFull    Boolean  @default(false) @map("analytics_full")
  removeBranding   Boolean  @default(false) @map("remove_branding")
  isActive         Boolean  @default(true) @map("is_active")
  displayOrder     Int      @default(0) @map("display_order")
  // Resource Governance Limits (null = unlimited)
  maxApiCallsDaily Int?     @map("max_api_calls_daily") // Daily API request quota per tenant
  maxStorageMb     Int?     @map("max_storage_mb") // MaxStorage in MB for product images
  maxRpm           Int      @default(120) @map("max_rpm") // Max requests per minute (noisy neighbor)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenants       Tenant[]
  subscriptions Subscription[]
  promoCodes    PromoCode[]
  history       SubscriptionHistory[] @relation("HistoryNewPlan")
  historyOld    SubscriptionHistory[] @relation("HistoryOldPlan")

  @@map("subscription_plans")
}

model StarterTemplate {
  id           String   @id @default(uuid())
  templateName String   @unique @map("template_name")
  data         Json
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("starter_templates")
}

