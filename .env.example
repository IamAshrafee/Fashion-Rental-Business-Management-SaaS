# ============================================
# ClosetRent SaaS — Environment Variables
# Copy to .env and fill in real values
# ============================================

# Application
NODE_ENV=development
APP_PORT=4000
FRONTEND_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_BASE_DOMAIN=localhost

# Database (PostgreSQL)
DATABASE_URL=postgresql://closetrent:dev_password@localhost:5433/closetrent_dev
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=closetrent_dev
DATABASE_USER=closetrent
DATABASE_PASSWORD=dev_password

# Cache (Redis)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Object Storage (MinIO / S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=closetrent-dev
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
STORAGE_PUBLIC_URL=http://localhost:9000/closetrent-dev

# Authentication
JWT_SECRET=dev-jwt-secret-change-in-production
# Independent 32+ character secret used to encrypt courier API credentials at rest.
CREDENTIALS_ENCRYPTION_KEY=dev-provider-credentials-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=10

# Domain & Tenant
BASE_DOMAIN=localhost:3000
ADMIN_SUBDOMAIN=admin
SERVER_IP=127.0.0.1

# Image Processing
MAX_IMAGE_SIZE_MB=5
IMAGE_QUALITY=80
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1920
THUMBNAIL_WIDTH=400
THUMBNAIL_HEIGHT=400

# Payment Gateways (optional — enable when needed)
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_IS_SANDBOX=true
# SSLCOMMERZ_SUCCESS_URL=
# SSLCOMMERZ_FAIL_URL=
# SSLCOMMERZ_CANCEL_URL=
# SSLCOMMERZ_IPN_URL=

# SMS Gateway (required in production; POST JSON with Bearer authentication)
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=ClosetRent

# Operations UI credentials (required in production)
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=

# Idempotent platform seed
# These development defaults are rejected when NODE_ENV=production.
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@closetrent.com
SEED_ADMIN_PHONE=+8801700000000
SEED_ADMIN_PASSWORD=ClosetRent-Local-Admin-2026

# Courier Integration (optional)
# PATHAO_API_URL=
# PATHAO_API_KEY=
# PATHAO_SECRET_KEY=
# STEADFAST_API_URL=
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=

# Email (future)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
