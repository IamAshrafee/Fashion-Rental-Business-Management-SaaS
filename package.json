{
  "name": "closetrent",
  "version": "0.1.0",
  "private": true,
  "description": "ClosetRent — Fashion Rental Business Management SaaS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-environment.mjs start",
    "dev:prepare": "node scripts/dev-environment.mjs prepare",
    "dev:status": "node scripts/dev-environment.mjs status",
    "dev:stop": "node scripts/dev-environment.mjs stop",
    "dev:reset": "node scripts/dev-environment.mjs reset",
    "env:check": "node scripts/dev-environment.mjs check",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build:types": "npm run build --workspace=packages/types",
    "db:generate": "npm run db:generate --workspace=apps/backend",
    "db:validate": "npm run db:validate --workspace=apps/backend",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "db:seed": "npm run db:seed --workspace=apps/backend",
    "test:dev-scripts": "node --test scripts/dev-environment.test.mjs",
    "test:integration": "npm run test:integration --workspace=apps/backend",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/typescript-estree": "^8.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "bull": "^4.16.5"
  }
}
